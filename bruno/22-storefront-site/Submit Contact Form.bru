meta {
  name: Submit Contact Form
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/contact
  body: json
  auth: none
}

body:json {
  {
    "name": "Example",
    "email": "buyer@example.com",
    "subject": "string",
    "message": "string"
  }
}

docs {
**Access:** Public (no token)

**Rate limit:** 5/hour

**Request body** `ContactRequest`:
  - `name`: string (required)
  - `email`: string (required)
  - `subject`: string (required)
  - `message`: string (required)

**Responses:** 200, 422
}
