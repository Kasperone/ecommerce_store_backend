}

params:path {
  product_id: 1
}

body:json {
  {
    "options": [
      {
        "name": "Example",
        "values": [
          {
            "value": "string"
          }
        ]
      }
    ],
    "variants": [
      {
        "option_values": []
      }
    ]
  }
}

docs {
**Access:** Admin (bearer)

**Request body** `ProductOptionsMatrixUpdate`:
  - `options`: array[ProductOptionInput] (required)
  - `variants`: array[ProductVariantInput] (required)

**Responses:** 200, 422
