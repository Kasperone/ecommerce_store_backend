meta {
  name: Restock Product
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/admin/inventory/products/:product_id/restock
  body: json
  auth: inherit
}

params:path {
  product_id: 1
}

body:json {
  {
    "warehouse_id": 1,
    "quantity": 1
  }
}

docs {
**Access:** Admin (bearer)

**Request body** `RestockRequest`:
  - `warehouse_id`: integer (required)
  - `variant_id`: integer|null
  - `quantity`: integer (required)
  - `note`: string|null

**Responses:** 200, 422
}
