meta {
  name: Update Category
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/categories/:category_id
  body: json
  auth: inherit
}

params:path {
  category_id: 1
}

body:json {
  {
    "name": "Example",
    "slug": "example-slug",
    "description": "string"
  }
}

docs {
**Access:** Admin (bearer)

**Request body** `CategoryUpdate`:
  - `name`: string|null
  - `slug`: string|null
  - `description`: string|null
  - `is_active`: boolean|null
  - `parent_id`: integer|null
  - `sort_order`: integer|null
  - `name_pl`: string|null
  - `slug_pl`: string|null
  - `description_pl`: string|null
  - `meta_title`: string|null
  - `meta_description`: string|null
  - `meta_title_pl`: string|null
  - `meta_description_pl`: string|null
  - `google_product_category`: string|null

**Responses:** 200, 422
}
