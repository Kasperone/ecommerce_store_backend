meta {
  name: Publish Page
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/admin/pages/:page_id/publish
  body: formUrlEncoded
  auth: inherit
}

params:path {
  page_id: 1
}

body:form-urlencoded {
  username: {{email}}
  password: {{password}}
}

docs {
**Access:** Admin (bearer)

**Responses:** 200, 422
}
