meta {
  name: Adjust Gift Card
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/gift-cards/:gift_card_id/adjust
  body: json
  auth: inherit
}

params:path {
  gift_card_id: 1
}

body:json {
  {
    "amount": 10.0
  }
}

docs {
**Access:** Admin (bearer)

**Request body** `GiftCardAdjustRequest`:
  - `amount`: number (required)
  - `note`: string|null

**Responses:** 200, 422
}
