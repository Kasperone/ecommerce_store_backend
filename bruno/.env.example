# Bruno collection credentials.
# Copy this file to `bruno/.env` (gitignored) and fill in your LOCAL dev seed accounts.
# Never put real or production credentials here.
BRUNO_EMAIL=
BRUNO_PASSWORD=
BRUNO_ADMIN_EMAIL=
BRUNO_ADMIN_PASSWORD=
# Optional — only to fire POST /auth/refresh/ssr (internal SSR refresh); matches backend SSR_SHARED_SECRET.
BRUNO_SSR_SECRET=
