meta {
  name: Login (admin)
  type: http
  seq: 99
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{adminEmail}}
  password: {{adminPassword}}
}

script:post-response {
  if (res.status === 200 && res.body && res.body.access_token) {
    bru.setEnvVar("token", res.body.access_token);
    console.log("Logged in as ADMIN, token stored");
  }
}

docs {
  Logs in with the admin credentials and overwrites `token`. Run this once to
  switch the whole collection to admin-level access.
}
