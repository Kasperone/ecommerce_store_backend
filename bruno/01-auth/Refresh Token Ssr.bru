meta {
  name: Refresh Token Ssr
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh/ssr
  body: none
  auth: none
}

headers {
  X-SSR-Secret: {{ssrSecret}}
}

docs {
**Access:** Internal (X-SSR-Secret shared-secret header; not user-facing)

**Secret header:** `X-SSR-Secret: {{ssrSecret}}` — set `BRUNO_SSR_SECRET` in `bruno/.env`.
}
