# Application
APP_NAME="E-commerce API"
APP_VERSION="0.1.0"
DEBUG=True
# ENVIRONMENT controls dev-only conveniences (e.g. auto-verifying users on
# registration when no email provider is configured). Must be one of:
# development | staging | production. Anything other than "development"
# requires RESEND_API_KEY to be configured for email verification to work.
ENVIRONMENT=development
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Must be >= 32 bytes — Settings validator rejects shorter values at startup.
SECRET_KEY=your-secret-key-here-change-in-production-must-be-32-bytes-or-longer

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_db

# JWT
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Must be >= 32 bytes — Settings validator rejects shorter values at startup.
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production-must-be-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Shared secret for the SSR session-validation endpoint (POST /auth/refresh/ssr).
# Must MATCH the Nuxt frontend's NUXT_SSR_SHARED_SECRET. The SSR server sends it
# as the X-SSR-Secret header to validate the refresh cookie and mint an access
# token WITHOUT rotating (used on every server-rendered cold load). Leave empty
# to disable the endpoint (SSR then falls back to the logged-out shell + a
# client-side restore). Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SSR_SHARED_SECRET=

# Admin "view as customer" impersonation
IMPERSONATION_TOKEN_EXPIRE_MINUTES=30
# Kill-switch — set to false to disable impersonation in this environment (endpoint 503s)
IMPERSONATION_ENABLED=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Rate limiting (slowapi). Default in-memory works for single-instance dev.
# Use a Redis URL in production so limits are shared across workers/instances.
# Example: redis://:${REDIS_PASSWORD}@localhost:6379/0
RATE_LIMIT_STORAGE_URL=memory://

# Redis password — required even in dev because docker-compose now refuses
# to start without one. Generate with `python -c 'import secrets;
# print(secrets.token_urlsafe(24))'`
REDIS_PASSWORD=change-me-local-dev-only

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=ecommerce-images
R2_PUBLIC_URL=https://your-bucket.r2.cloudflarestorage.com

# Email / Resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME="E-commerce Store"
FRONTEND_URL=http://localhost:3000
# Public origin of THIS backend. Used to build provider webhook/notify URLs
# (PayU notifyUrl, Stripe webhook) — these are server-to-server, so for local
# sandbox testing this must be a public HTTPS tunnel, NOT localhost
# (e.g. `cloudflared tunnel --url http://localhost:8000`, then paste its URL here).
BACKEND_URL=http://localhost:8000

# PayU (Polish market). Sandbox: create a POS in the PayU sandbox panel, then map
# POS ID -> PAYU_POS_ID, OAuth client_id -> PAYU_CLIENT_ID (usually = POS ID),
# OAuth client_secret -> PAYU_CLIENT_SECRET, and "Second key (MD5)" -> PAYU_SECOND_KEY
# (verifies the notification signature). Requires a public BACKEND_URL (above) so
# PayU's server-to-server notifyUrl can reach this backend.
PAYU_POS_ID=your-payu-pos-id
PAYU_CLIENT_ID=your-payu-client-id
PAYU_CLIENT_SECRET=your-payu-client-secret
PAYU_SECOND_KEY=your-payu-second-key-md5
PAYU_SANDBOX=True

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Meilisearch (storefront search). Leave empty to disable — search endpoints
# 503 and index sync no-ops. MEILI_MASTER_KEY is consumed by docker-compose to
# start the engine; MEILISEARCH_MASTER_KEY (same value) is what the backend uses.
# Seed the index after first boot: python -m app.scripts.reindex_search
MEILI_MASTER_KEY=change-me-local-dev-only
MEILISEARCH_URL=http://192.168.1.14:7700
MEILISEARCH_MASTER_KEY=change-me-local-dev-only

# Invoice / store identity (printed on generated order invoices). All optional —
# defaults keep the app booting; set real values for production-looking invoices.
STORE_NAME="E-commerce Store"
STORE_ADDRESS_LINE="ul. Sklepowa 1"
STORE_POSTAL_CITY="00-123 Warszawa"
STORE_COUNTRY="Poland"
STORE_TAX_ID="PL0000000000"
STORE_EMAIL="shop@yourdomain.com"
# Gross-inclusive VAT rate (%) used to decompose net/VAT on invoices. 0 = no VAT
# block (plain receipt). Applied uniformly across currencies in v1.
INVOICE_VAT_RATE=23
# Sequential faktura numbering. INVOICE_NUMBER_FORMAT is a Python str.format
# template; placeholders: {prefix} {year} {month} {seq} (e.g. {seq:05d} zero-pads).
# Custom/hand-written templates are allowed (validated at startup). The sequence
# resets each calendar year, so {month} is display-only. A number is assigned when
# an order is paid; pending orders render a proforma.
INVOICE_NUMBER_PREFIX="FV"
INVOICE_NUMBER_FORMAT="{prefix}/{year}/{seq:05d}"
