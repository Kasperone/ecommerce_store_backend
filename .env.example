# Application
APP_NAME="E-commerce API"
APP_VERSION="0.1.0"
DEBUG=True
# ENVIRONMENT controls dev-only conveniences (e.g. auto-verifying users on
# registration when no email provider is configured). Must be one of:
# development | staging | production. Anything other than "development"
# requires RESEND_API_KEY to be configured for email verification to work.
ENVIRONMENT=development
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Must be >= 32 bytes — Settings validator rejects shorter values at startup.
SECRET_KEY=your-secret-key-here-change-in-production-must-be-32-bytes-or-longer

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_db

# JWT
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Must be >= 32 bytes — Settings validator rejects shorter values at startup.
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production-must-be-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Rate limiting (slowapi). Default in-memory works for single-instance dev.
# Use a Redis URL in production so limits are shared across workers/instances.
# Example: redis://:${REDIS_PASSWORD}@localhost:6379/0
RATE_LIMIT_STORAGE_URL=memory://

# Redis password — required even in dev because docker-compose now refuses
# to start without one. Generate with `python -c 'import secrets;
# print(secrets.token_urlsafe(24))'`
REDIS_PASSWORD=change-me-local-dev-only

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=ecommerce-images
R2_PUBLIC_URL=https://your-bucket.r2.cloudflarestorage.com

# Email / Resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME="E-commerce Store"
FRONTEND_URL=http://localhost:3000

# PayU
PAYU_POS_ID=your-payu-pos-id
PAYU_CLIENT_ID=your-payu-client-id
PAYU_CLIENT_SECRET=your-payu-client-secret
PAYU_SANDBOX=True

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Meilisearch (storefront search). Leave empty to disable — search endpoints
# 503 and index sync no-ops. MEILI_MASTER_KEY is consumed by docker-compose to
# start the engine; MEILISEARCH_MASTER_KEY (same value) is what the backend uses.
# Seed the index after first boot: python -m app.scripts.reindex_search
MEILI_MASTER_KEY=change-me-local-dev-only
MEILISEARCH_URL=http://192.168.1.14:7700
MEILISEARCH_MASTER_KEY=change-me-local-dev-only
