# Backend — PRODUCTION environment template.
#
# Copy into your secrets store (Doppler / platform env), NOT a committed .env.
# Placeholders only — fill real values per environment. Settings are defined in
# app/core/config.py; this lists every prod-relevant var with guidance.
#
# Secrets to GENERATE (not third-party): SECRET_KEY, JWT_SECRET_KEY,
# SSR_SHARED_SECRET.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Third-party keys (gate those features; each is 503-gated so the app still boots
# without them): Stripe, PayU, Meilisearch. R2 + Resend you already hold.

# ── Application ──────────────────────────────────────────────────────────────
# production turns HSTS on (see SecurityHeadersMiddleware) and is the intended
# value live; keep DEBUG off.
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=CHANGE-ME-generate-32+-bytes
JWT_SECRET_KEY=CHANGE-ME-generate-32+-bytes-distinct-from-SECRET_KEY

# ── Database (managed Postgres) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@db-host:5432/ecommerce_prod

# ── JWT / tokens (defaults shown; override only if needed) ───────────────────
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=14
IMPERSONATION_TOKEN_EXPIRE_MINUTES=30
# Kill-switch — set false to disable admin "view as customer" without a deploy.
IMPERSONATION_ENABLED=true

# ── SSR session validation ───────────────────────────────────────────────────
# Shared secret for POST /auth/refresh/ssr. Must MATCH the frontend's
# NUXT_SSR_SHARED_SECRET. Effectively REQUIRED in production: if empty, every
# SSR cold load falls back to the rotating POST /auth/refresh, whose 30/hour
# IP rate limit is shared by all users behind the SSR origin — exhausting it
# logs users out.
SSR_SHARED_SECRET=CHANGE-ME-generate-32+-bytes-match-frontend

# ── CORS — the prod frontend origin(s) (JSON list, no trailing slash) ────────
CORS_ORIGINS=["https://your-frontend-domain.com"]

# ── Rate limiting ────────────────────────────────────────────────────────────
# MUST be Redis in prod (memory:// is per-process and won't share across
# workers/instances, so limits would be bypassable).
RATE_LIMIT_STORAGE_URL=redis://:password@redis-host:6379/0

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend-domain.com
# Public URL of THIS backend — must be reachable by Stripe/PayU webhooks.
BACKEND_URL=https://api.your-domain.com

# ── Cloudflare R2 (product/category images) ──────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://images.your-domain.com

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=Your Store

# ── Payments — Stripe (use LIVE keys in prod) ────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Payments — PayU (set sandbox=false for the production POS) ───────────────
PAYU_POS_ID=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_SECOND_KEY=
PAYU_SANDBOX=false

# ── Search (Meilisearch) ─────────────────────────────────────────────────────
MEILISEARCH_URL=https://search.your-domain.com
MEILISEARCH_MASTER_KEY=

# ── Store identity / invoices (printed on order invoices) ────────────────────
STORE_NAME=Your Store
STORE_ADDRESS_LINE=
STORE_POSTAL_CITY=
STORE_COUNTRY=
STORE_TAX_ID=
STORE_EMAIL=billing@your-domain.com
# Gross-inclusive VAT rate (%); 0 = plain receipt (no VAT block).
INVOICE_VAT_RATE=23
# Sequential faktura numbering — str.format template ({prefix} {year} {month} {seq}).
INVOICE_NUMBER_PREFIX=FV
INVOICE_NUMBER_FORMAT={prefix}/{year}/{seq:05d}
