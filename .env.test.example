# Copy to .env.test (gitignored) and adjust for your environment.
# tests/conftest.py loads this file via python-dotenv BEFORE app.* is imported,
# so values here override anything in .env for the duration of the test run.

ENVIRONMENT=development
DEBUG=False

# Test database — must be a DEDICATED database, not the dev one. The fixture
# drops and re-migrates the schema on every session.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@192.168.1.14:5433/ecommerce_test

# Secrets — fixed values keep test JWTs deterministic across runs.
# Both must be >= 32 bytes (Settings validator at startup); pad with
# `--not-for-prod--padding` to clear the threshold while staying obviously
# non-secret.
SECRET_KEY=test-secret-not-for-prod--not-for-prod--padding
JWT_SECRET_KEY=test-jwt-secret-not-for-prod--not-for-prod--padding

# Email — empty key makes Resend calls no-op-able; tests monkeypatch the
# send_* helpers directly so this never reaches the network.
RESEND_API_KEY=
EMAIL_FROM=test@example.com
EMAIL_FROM_NAME=Test
FRONTEND_URL=http://localhost:3000

# Rate limiter — in-memory storage so the limiter fixture can clear it
# between tests.
RATE_LIMIT_STORAGE_URL=memory://

# Blank out optional providers so their *_when_unconfigured tests behave like
# CI (where no .env exists). Without these, a configured dev .env leaks through
# pydantic-settings' env_file fallback and 4 stripe/search tests fail locally.
MEILISEARCH_URL=
MEILISEARCH_MASTER_KEY=
MEILI_MASTER_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYU_POS_ID=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_SECOND_KEY=
PAYU_SANDBOX=true
